# ---------------------------------------------------------------------------
# Secure Quiz Platform — backend environment
# Copy to backend/.env (local) or set in Render dashboard (production).
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never commit real values.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
PORT=8000                          # Render injects this; Uvicorn must honour it

# --- Database (Supabase PostgreSQL) ----------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the pooled (pgBouncer, port 6543) URI for the app; the direct (5432)
# URI for Alembic migrations.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:REPLACE_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:REPLACE_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Supabase (Auth + Storage) ---------------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
# BACKEND ONLY. Never ship to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
# Supabase -> Project Settings -> API -> JWT Settings -> JWT Secret (HS256 projects)
SUPABASE_JWT_SECRET=REPLACE_WITH_JWT_SECRET
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET_EVIDENCE=evidence
SUPABASE_STORAGE_BUCKET_EXPORTS=exports

# --- AI (Gemini) -----------------------------------------------------------
# BACKEND ONLY. Never exposed to the frontend.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER=gemini                 # gemini | stub (stub = offline/test only)
# Live-measured: flash-lite generation takes ~55-70s regardless of variant
# count. 60s timed out on nearly every real call; do not lower this.
AI_REQUEST_TIMEOUT_SECONDS=120

# --- Storage (Supabase Storage) --------------------------------------------
STORAGE_PROVIDER=supabase           # supabase | stub (stub = tests/offline only)
# Retain generated exports in the private `exports` bucket. Off by default: a
# workbook is regenerable from the database at any time, and not storing
# student marks is the safer default. Turning this on requires
# SUPABASE_SERVICE_ROLE_KEY.
RETAIN_EXPORTS=false
EXPORT_SIGNED_URL_TTL_SECONDS=300

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_PROVIDER=resend              # resend | stub
EMAIL_FROM="Secure Quiz <results@example.com>"

# --- Web / CORS ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- API hardening ---------------------------------------------------------
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_ATTEMPT_START=10/minute
RATE_LIMIT_ANSWER=240/minute
RATE_LIMIT_EVENT=300/minute
RATE_LIMIT_EXPORT=10/minute
RATE_LIMIT_EMAIL=5/minute
MAX_REQUEST_BYTES=262144

# --- Exam engine defaults --------------------------------------------------
ATTEMPT_GRACE_SECONDS=5            # clock-skew grace before hard expiry
DEFAULT_VARIANTS_PER_QUESTION=5
